package main

import (
{{ if or .IsExternal .IsScript }}	"context"
{{ end }}	"log"
	"time"

	"github.com/kode4food/argyll/engine/pkg/api"
	"github.com/kode4food/argyll/sdk/go"
)

func main() {
	client := argyll.NewClient(argyll.EnvOr(argyll.EnvLookup{
		Name:    "ARGYLL_URL",
		Default: argyll.DefaultURL,
	}), 30*time.Second)
{{ if and (not .IsExternal) (not .IsScript) }}
	handler := func(
		ctx *argyll.StepContext, args api.Args,
	) (api.Args, error) {
{{ if .IsAsync }}		asyncCtx, err := argyll.NewAsyncContext(ctx)
		if err != nil {
			return nil, err
		}
		go func() {
			asyncCtx.Success(api.Args{})
		}()
		return api.Args{}, nil
{{ else }}		return api.Args{
{{ range .Outputs }}			{{ quoteName . }}: nil,
{{ end }}		}, nil
{{ end }}	}

{{ end }}	step := client.NewStep().
		WithName({{ quoteName .StepName }}){{ range .Inputs }}.
		Required({{ quoteName . }}){{ end }}{{ range .Outputs }}.
		Output({{ quoteName . }}){{ end }}{{ if .IsAsync }}.
		WithAsyncInvoke(){{ end }}{{ if .IsExternal }}.
{{ if .HasNonPostMethod }}		WithMethod({{ quote .Method }}).
{{ end }}		WithEndpoint("https://step.example.com/step"){{ end }}{{ if .IsScript }}.
		WithScript(api.ScriptConfig{
			Language: {{ quote .ScriptLanguage }},
			Source:   {{ quote .ScriptBody }},
		}){{ end }}
{{ if or .IsExternal .IsScript }}	if err := step.Register(
		context.Background(),
	); err != nil {
{{ else }}	if err := step.Start(handler); err != nil {
{{ end }}		log.Fatal(err)
	}
}
